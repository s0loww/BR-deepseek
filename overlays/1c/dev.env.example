# Параметры 1С-проекта для rules/dev-standards-core.md (§1).
# При установке копируется в корень цели как .dev.env.example; рабочий файл —
# .dev.env (создаёт установщик, поля без значения — спросить или НЕ НАСТРОЕНО).
# Секретов здесь нет — файл можно коммитить.
# PREFIX и PLATFORM_VERSION обязаны совпадать с корневым контрактом
# (AGENTS.md); при расхождении — спросить.

PREFIX=xx_
COMPANY=<ИмяКомпании>
DEVELOPER=<ИмяРазработчика>
PLATFORM_VERSION=8.3.24
COMMENT_OPEN=// {COMPANY} {DEVELOPER} {DATE} {TASK} нач
COMMENT_CLOSE=// {COMPANY} {DEVELOPER} {DATE} {TASK} кон
NEW_OBJECTS_IN=main_configuration
