Процедура ЗагрузитьДанные(Ссылки) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Документ.Реализация ГДЕ Ссылка В (&Список)";
	Запрос.УстановитьПараметр("Список", Ссылки);
	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбработатьСтроку(Выборка);
	КонецЦикла;
КонецПроцедуры
